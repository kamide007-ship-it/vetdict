# =============================================================================
# VetDict Environment Configuration
# =============================================================================

# --- Required in Production ---------------------------------------------------

# Flask secret key (used for session signing). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Internal API token for protected RECO2/RECO3 endpoints
INTERNAL_API_TOKEN=

# Anthropic API key (required for AI features)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --- Optional -----------------------------------------------------------------

# Debug mode (default: 0 = off). Set to 1 only for local development.
FLASK_DEBUG=0

# CORS allowed origins (comma-separated). Leave empty for permissive mode.
# Example: https://vetdict.example.com,https://staging.vetdict.example.com
CORS_ALLOWED_ORIGINS=

# Disease Enrichment Settings
DISEASE_ENRICHMENT_BATCH_SIZE=543
DISEASE_ENRICHMENT_MAX_RETRIES=3
