# VetDict Environment Configuration
# Copy this file to .env and update values as needed

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Port Configuration
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# Database Configuration (PostgreSQL)
DB_USER=vetdict
DB_PASSWORD=changeme
DB_NAME=vetdict
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_TITLE=VetDict API
API_VERSION=1.0.0
API_DESCRIPTION=Multi-Species Veterinary Disease Database

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_HEADERS=["*"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Features
ENABLE_SWAGGER=true
ENABLE_SEARCH=true
ENABLE_PAGINATION=true
PAGE_SIZE=10
MAX_PAGE_SIZE=100
