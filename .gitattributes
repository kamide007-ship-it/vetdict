# Git LFS tracking for large binary/data files.
# NOTE: diseases_all_species.json is intentionally NOT tracked by LFS. It is
# read at import time by api/species/*_diseases.py (and therefore by the live
# gunicorn app on Render, whose build does not run `git lfs pull`). Storing it
# as a regular git blob — written compactly to stay under GitHub's 100 MiB
# blob limit — guarantees the disease database is present in every checkout.
instance/vetdict.db filter=lfs diff=lfs merge=lfs -text
diseases.db filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
